<script>
    export default function(props, {$, $el, $f7, $f7route, $f7router, $h, $on, $store, $theme, $update}) {
        const copyProtocolLink = async function() {
            try {
                await navigator.clipboard.writeText('web+symphone://open');
                $f7.toast.show({text: 'Protocol link copied'});
            } catch (error) {
                $f7.dialog.alert('Copy web+symphone://open and paste it into your browser address bar.');
            }
        };

        return $render;
    }
</script>
