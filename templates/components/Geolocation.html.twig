<div
    data-controller="pwa--geolocation live"
    {{ attributes }}
    class="block block-strong inset"
>
        <button
            data-action="click->pwa--geolocation#watch"
            data-pwa--geolocation-enable-high-accuracy-param=true
            data-pwa--geolocation-maximum-age-param=500
            data-pwa--geolocation-timeout-param=1000
            class="button button-fill"
        >
            Tell me where I am
        </button>
        <div class="list simple-list">
            <ul>
                <li>Latitude: <span>{{ this.latitude }}</span></li>
                <li>Longitude: <span>{{ this.longitude }}</span></li>
            </ul>
        </div>
        <twig:ux:map
            :center="[this.latitude, this.longitude]"
            :zoom="this.zoom"
            style="width: 100%; height: 384px; margin-top: 16px;"
            :markers='[{"position": [this.latitude, this.longitude], "title": "Your location"}]'
        />
</div>
