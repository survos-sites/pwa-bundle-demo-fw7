<div{{ attributes }}>
    <div
        class="block"
        data-controller="pwa--device-motion motion"
        {{ stimulus_action('motion', 'update', 'pwa--device-motion:pwa:device:motion') }}
        {{ stimulus_action('motion', 'disable', 'pwa--device-motion:pwa:device:motion:unavailable') }}
    >
        <div class="block block-strong inset hidden" {{ stimulus_target('motion', 'message')}}>
            <div class="display-flex align-items-center">
                <twig:ux:icon name="material-symbols:warning-rounded" class="icon size-20 margin-right-half color-yellow flex-shrink-0" alt="" />
                <div>
                    <span class="font-weight-600">Not available</span>: This feature is not available on your platform or not granted.
                </div>
            </div>
        </div>
        <div class="list simple-list">
            <ul>
                <li>Acceleration: <span {{ stimulus_target('motion', 'acceleration') }}>--</span></li>
                <li>Acceleration with gravity: <span {{ stimulus_target('motion', 'accelerationIncludingGravity') }}>--</span></li>
                <li>Rotation rate: <span {{ stimulus_target('motion', 'rotationRate') }}>--</span></li>
                <li>Interval: <span {{ stimulus_target('motion', 'interval') }}>--</span></li>
            </ul>
        </div>
        <canvas {{ stimulus_target('motion', 'canvas') }} id="myCanvas" style="width: 100%; height: 384px;">
            Your browser does not support the HTML canvas element.
        </canvas>
    </div>
</div>
