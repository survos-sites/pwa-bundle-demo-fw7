<div{{ attributes }}>
    <div
        class="block"
        data-controller="pwa--device-orientation orientation"
        data-pwa--device-orientation-throttle-value="25"
        {{ stimulus_action('orientation', 'update', 'pwa--device-orientation:pwa:device:orientation') }}
    >
        <div class="list simple-list">
            <ul>
                <li id="alpha">Alpha: <span {{ stimulus_target('orientation', 'alpha') }}>--</span></li>
                <li id="beta">Beta: <span {{ stimulus_target('orientation', 'beta') }}>--</span></li>
                <li id="gamma">Gamma: <span {{ stimulus_target('orientation', 'gamma') }}>--</span></li>
            </ul>
        </div>
        <canvas {{ stimulus_target('orientation', 'canvas') }} id="myCanvas" style="width: 100%; height: 384px;">
            Your browser does not support the HTML canvas element.
        </canvas>
    </div>
</div>
