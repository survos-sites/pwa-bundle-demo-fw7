<section {{ attributes }}>
    <div class="block block-strong inset text-align-center">
        <img
            src="{{ asset('images/pwabundlelogo.svg') }}"
            width="80"
            height="80"
            alt="{{ 'app.name'|trans(domain: 'pwa') }}"
        />
        <h1>{{ 'app.name'|trans(domain: 'pwa') }}</h1>
        <p>{{ 'app.description'|trans(domain: 'pwa') }}</p>
    </div>

    <div class="block-title block-title-medium">What is a Progressive Web App?</div>
    <div class="block block-strong inset">
        <p>A Progressive Web App (PWA) is a website that can be installed on your device and provide an app-like experience.</p>
    </div>

    <div class="block-title block-title-medium">Install Symphone</div>
    <div class="block block-strong inset">
        <p>Install this Progressive Web App on your mobile device or desktop. Your browser will present its installation prompt when available.</p>
        <button
            type="button"
            class="button button-fill button-large"
            data-action="click->pwa--install#install"
        >
            Install this app
        </button>
    </div>

    <div class="block-title">Open on another device</div>
    <div class="block block-strong inset text-align-center">
        <img
            src="{{ qr_code_url(url('app_homepage', {_locale: app.request.locale})) }}"
            width="128"
            height="128"
            alt="QR code for this page"
        />
        <p>Scan the QR code on your mobile phone to access the app.</p>
    </div>
</section>
